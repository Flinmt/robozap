# Configuracao do Servidor Web
PORT=3000
BASE_PATH=
INSTANCE_ID=cliente-local-01
RUNTIME_CONFIG_PATH=config/runtime-config.json

# Admin (seguranca)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_SESSION_SECRET=troque-este-segredo

# Configuracao do Banco de Dados SQL Server
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_SERVER=seu_servidor_sql
DB_NAME=biodata
DB_REQUEST_TIMEOUT=60000

# Configuracao da API PartnerBot (WhatsApp)
URL=https://api.partnerbot.com.br/api/v1/send
SHOWTICKET_URL=
AUTH_TOKEN=seu_token_de_autenticacao

# Regras avancadas de envio (opcionais)
WORKER_PAUSED=true
USE_TICKET_OPEN_FOR_IS_CLOSED=false
NORMALIZE_BRAZIL_MOBILE_NINTH_DIGIT=true

# Defaults operacionais usados somente enquanto runtime-config.json nao existir
PARTNERBOT_IS_CLOSED=false
PARTNERBOT_INCLUDE_PROCEDURE=false
PARTNERBOT_INCLUDE_COMPANY=false
PARTNERBOT_INCLUDE_UNIT=false
PARTNERBOT_INCLUDE_CONFIRMATION_BUTTON=false
DEFAULT_UNIT_ADDRESS=
FORMAT_TURN_SCHEDULE=false
USE_AGENDA_UNIT_ADDRESS=false
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=17
QUEUE_PRODUCER_ENABLED=false
QUEUE_PRODUCER_LOOKAHEAD_DAYS=7
QUEUE_PRODUCER_LIMIT=50
SEND_INTERVAL_SECONDS=10
TEST_MODE_ENABLED=true
TEST_PATIENT_NAME_FILTER=TESTE
SYNC_AGENDA_WHATSAPP_STATUS=false
MESSAGING_START_DATE=
SKIP_PAST_APPOINTMENT_TIME=false
OUTBOUND_SEND_START_DATE=

# Observacao:
# CLIENT_NAME, CLIENT_CODE e os templates devem ser configurados no painel.
# O JSON persistido tem prioridade sobre os defaults operacionais acima.
